# Cloudflare Workers static assets: response headers (this file itself is not served).
# HTML keeps Cloudflare's default "max-age=0, must-revalidate" so content changes show up immediately.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/images/*
  Cache-Control: public, max-age=604800

/css/*
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=14400, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=604800
