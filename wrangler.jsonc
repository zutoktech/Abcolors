{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abcolors",
  "compatibility_date": "2026-09-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      ".git",
      ".git/**",
      ".github",
      ".github/**",
      ".vscode",
      ".vscode/**",
      ".ftpquota"
    ]
  }
}
